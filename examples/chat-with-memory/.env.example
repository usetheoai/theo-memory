# --- Required ---

# OpenAI key for chat completion (LLM) + embeddings — powers the SDK Agent
# AND theo-memory's LLM-extraction + embedder. One key, both layers.
OPENAI_API_KEY=sk-...

# Theokit Cloud API key — required by @usetheo/sdk Agent.create().
# Get one at https://usetheo.dev (public beta).
THEOKIT_API_KEY=tkt-...

# --- Optional ---

# Default model id passed to Agent.create. Leave blank to use SDK default.
# Examples: "composer-2", "claude-opus-4", "gpt-4o".
NEXT_PUBLIC_AGENT_MODEL_ID=composer-2

# Reflection (memory consolidation) trigger threshold.
# After N new memories in a scope, theo-memory consolidates via LLM.
# Default 10. Set to 0 to disable auto-reflection.
THEOMEM_REFLECTION_THRESHOLD=10

# Optional: switch to pgvector backend. Defaults to InMemoryVectorStore
# (zero infra — perfect for first run). When set, theo-memory persists to
# Postgres + pgvector. Apply migrations with `npm run db:push` from repo root.
# THEOMEM_PG_URI=postgresql://postgres:postgres@localhost:5432/themory_demo
