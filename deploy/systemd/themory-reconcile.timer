# Timer da reconciliação pull-based. Instalado em ~/.config/systemd/user/.
[Unit]
Description=Dispara a reconciliação do dev host do theo-memory
Documentation=https://github.com/usetheoai/theo-memory/blob/develop/scripts/reconcile-dev.sh

[Timer]
# A cada 5 min. O script é idempotente — sem imagem nova ele compara dois digests e sai, sem
# reiniciar nada. Custo por tick é desprezível; a frequência define a JANELA MÁXIMA de drift, que
# é a métrica que importa: no pior caso o ambiente fica 5 min divergente, contra 1 h do gate de
# detecção e contra "até alguém perceber" antes disto existir.
OnBootSec=2min
OnUnitActiveSec=5min
# Espalha o disparo para não coincidir com o minuto cheio, quando cron/backup do box costumam
# concorrer por I/O.
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target
