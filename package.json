{
  "name": "theo-memory-workspace",
  "version": "0.2.0",
  "description": "Workspace root for @usetheo/memory monorepo",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "themory": "./dist/agent-tools/cli.js",
    "themory-mcp": "./dist/agent-tools/cli.js"
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.contract.json",
    "prebuild:clean": "node -e \"const{rmSync}=require('node:fs');rmSync('dist',{recursive:true,force:true});\"",
    "build": "npm run prebuild:clean && tsc -p tsconfig.build.json && npm run postbuild:move-cli && npm run postbuild:copy-migrations && npm run postbuild:rewrite-aliases",
    "postbuild:rewrite-aliases": "node scripts/rewrite-dist-aliases.mjs",
    "postbuild:move-cli": "node -e \"const{renameSync,rmSync,existsSync}=require('node:fs');const s='dist/cli/src',d='dist/agent-tools';if(existsSync(s)){if(existsSync(d))rmSync(d,{recursive:true});renameSync(s,d);try{require('node:fs').rmdirSync('dist/cli')}catch{};console.error('CLI moved to dist/agent-tools/')}\"",
    "prepack": "npm run build",
    "postbuild:copy-migrations": "node -e \"const{cpSync,existsSync,mkdirSync}=require('node:fs');const dest='dist/core/src/infrastructure/db/migrations';if(existsSync('packages/core/src/infrastructure/db/migrations')){mkdirSync(dest,{recursive:true});cpSync('packages/core/src/infrastructure/db/migrations',dest,{recursive:true});console.error('migrations copied to '+dest);}\"",
    "test:type": "tsc --noEmit -p tsconfig.contract.json --strict",
    "lint": "eslint 'packages/core/src/**/*.ts' 'packages/api/src/**/*.ts' 'packages/cli/src/**/*.ts' 'packages/agent-core/src/**/*.ts' --no-error-on-unmatched-pattern",
    "test": "vitest run --config vitest.contract.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:benchmark": "vitest run --config vitest.benchmark.config.ts",
    "db:push": "node -e \"const{Pool}=require('pg');const p=new Pool({connectionString:process.env.THEOMEM_PG_URI});p.query('CREATE EXTENSION IF NOT EXISTS vector').then(()=>p.end())\" && drizzle-kit push && node scripts/apply-trigger-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:repair-v0-4b-partial-state": "node scripts/db-repair-v0-4b-partial-state.mjs",
    "db:repair-v0-7-partial-state": "node scripts/db-repair-v0-7-partial-state.mjs",
    "download-fixtures": "node benchmarks/scripts/download-fixtures.mjs",
    "compose:up": "docker compose up -d pgvector",
    "compose:down": "docker compose down",
    "publish:check": "npm publish --dry-run --tag next",
    "eval:forgetting": "tsx docs/forgetting-evaluation/run.ts",
    "eval:distillation": "tsx docs/distillation-evaluation/run.ts",
    "test:all": "pnpm -r test && pnpm test"
  },
  "dependencies": {
    "@usetheo/memory": "workspace:*",
    "@usetheo/memory-api": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "openai": "^4.77.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-openapi": "^0.18.0",
    "@opentelemetry/api": "^1.9.0",
    "commander": "^12.1.0",
    "croner": "^10.0.1",
    "hono": ">=4.11.4",
    "jose": "^6.0.0",
    "oauth4webapi": "^3.8.6",
    "pg": "^8.13.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0",
    "drizzle-orm": "^0.45.0",
    "@usetheo/memory-mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.30.0",
    "jiti": "^2.7.0",
    "strip-ansi": "^7.1.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0",
    "vitest-mock-extended": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/usetheodev/theo-memory.git"
  },
  "bugs": {
    "url": "https://github.com/usetheodev/theo-memory/issues"
  },
  "homepage": "https://usetheo.dev",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "protobufjs"
    ]
  },
  "private": true,
  "optionalDependencies": {
    "natural": "^8.1.0"
  }
}
