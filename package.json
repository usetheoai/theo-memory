{
  "name": "theo-memory-workspace",
  "version": "0.2.0",
  "description": "Workspace root for @usetheo/memory monorepo",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "themory": "./dist/agent-tools/cli.js",
    "themory-mcp": "./dist/agent-tools/cli.js"
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.contract.json",
    "prebuild:clean": "node -e \"const{rmSync}=require('node:fs');rmSync('dist',{recursive:true,force:true});\"",
    "build": "npm run prebuild:clean && npm run build:core && tsc -p tsconfig.build.json && npm run postbuild:move-cli && npm run postbuild:copy-import && npm run postbuild:copy-migrations && npm run postbuild:rewrite-aliases && npm run postbuild:shebang",
    "build:core": "node -e \"require('node:fs').rmSync('packages/core/dist',{recursive:true,force:true})\" && tsc -p packages/core/tsconfig.build.json && node -e \"const{cpSync,existsSync}=require('node:fs');const s='packages/core/src/infrastructure/db/migrations',d='packages/core/dist/infrastructure/db/migrations';if(existsSync(s)){cpSync(s,d,{recursive:true});console.error('[core] migrations copied to '+d);}\"",
    "postbuild:rewrite-aliases": "node scripts/rewrite-dist-aliases.mjs",
    "postbuild:move-cli": "node -e \"const{renameSync,rmSync,existsSync}=require('node:fs');const s='dist/cli/src',d='dist/agent-tools';if(existsSync(s)){if(existsSync(d))rmSync(d,{recursive:true});renameSync(s,d);try{require('node:fs').rmdirSync('dist/cli')}catch{};console.error('CLI moved to dist/agent-tools/')}\"",
    "prepack": "npm run build",
    "postbuild:copy-migrations": "node -e \"const{cpSync,existsSync,mkdirSync}=require('node:fs');const dest='dist/core/src/infrastructure/db/migrations';if(existsSync('packages/core/src/infrastructure/db/migrations')){mkdirSync(dest,{recursive:true});cpSync('packages/core/src/infrastructure/db/migrations',dest,{recursive:true});console.error('migrations copied to '+dest);}\"",
    "test:type": "tsc --noEmit -p tsconfig.contract.json --strict",
    "lint": "eslint 'packages/core/src/**/*.ts' 'packages/api/src/**/*.ts' 'packages/cli/src/**/*.ts' 'packages/agent-core/src/**/*.ts' 'packages/mcp/src/**/*.ts' 'packages/eval/src/**/*.ts' --no-error-on-unmatched-pattern",
    "test": "vitest run --config vitest.contract.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:push": "node -e \"const{Pool}=require('pg');const p=new Pool({connectionString:process.env.THEOMEM_PG_URI});p.query('CREATE EXTENSION IF NOT EXISTS vector').then(()=>p.end())\" && drizzle-kit push && node scripts/apply-trigger-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:repair-v0-4b-partial-state": "node scripts/db-repair-v0-4b-partial-state.mjs",
    "db:repair-v0-7-partial-state": "node scripts/db-repair-v0-7-partial-state.mjs",
    "compose:up": "docker compose up -d pgvector",
    "compose:down": "docker compose down",
    "publish:check": "npm publish --dry-run --tag next",
    "eval": "pnpm --filter @usetheo/memory-eval eval",
    "eval:forgetting": "pnpm --filter @usetheo/memory-eval run eval:forgetting",
    "eval:distillation": "pnpm --filter @usetheo/memory-eval run eval:consolidation",
    "test:all": "pnpm -r test && pnpm test",
    "postbuild:copy-import": "node -e \"const{cpSync,existsSync,mkdirSync}=require('node:fs');const src='packages/cli/src/import',dest='dist/agent-tools/import';if(existsSync(src)){mkdirSync(dest,{recursive:true});cpSync(src,dest,{recursive:true});console.error('[cli] import engine (.mjs) copied to '+dest);}\"",
    "postbuild:shebang": "node scripts/add-cli-shebang.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hono/zod-openapi": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@usetheo/memory": "workspace:*",
    "@usetheo/memory-api": "workspace:*",
    "@usetheo/memory-mcp": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "commander": "^12.1.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.0",
    "hono": ">=4.12.27",
    "jose": "^6.0.0",
    "oauth4webapi": "^3.8.6",
    "openai": "^4.77.0",
    "pg": "^8.13.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "4.1.8",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.30.0",
    "jiti": "^2.7.0",
    "strip-ansi": "^7.1.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0",
    "vitest-mock-extended": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/usetheoai/theo-memory.git"
  },
  "bugs": {
    "url": "https://github.com/usetheoai/theo-memory/issues"
  },
  "homepage": "https://usetheo.dev",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "protobufjs",
      "isolated-vm"
    ],
    "overrides": {
      "sharp": "^0.35.0",
      "protobufjs": "7.6.1",
      "form-data": "4.0.6",
      "linkify-it": "5.0.1",
      "lodash": "4.18.1",
      "tmp": "0.2.7",
      "underscore": "1.13.8",
      "fast-uri": "^3.1.4",
      "@hono/node-server": "^2.0.5",
      "js-yaml": ">=4.3.0",
      "brace-expansion": ">=5.0.8",
      "minimatch@3>brace-expansion": "1.1.16"
    }
  },
  "private": true,
  "optionalDependencies": {
    "natural": "^8.1.0"
  }
}
