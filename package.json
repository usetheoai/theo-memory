{
  "name": "@usetheo/memory",
  "version": "0.2.0",
  "description": "Managed three-tier memory layer for the Theo ecosystem. Pre-release.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./packages/core/src/index.ts",
      "default": "./packages/core/src/index.ts"
    },
    "./contract": {
      "types": "./packages/core/src/domain/index.ts",
      "default": "./packages/core/src/domain/index.ts"
    },
    "./theokit": {
      "types": "./packages/core/src/infrastructure/theokit/index.ts",
      "default": "./packages/core/src/infrastructure/theokit/index.ts"
    },
    "./agent-tools": {
      "types": "./src/agent-tools/index.ts",
      "default": "./src/agent-tools/index.ts"
    },
    "./embedders": {
      "types": "./packages/core/src/infrastructure/embedders/index.ts",
      "default": "./packages/core/src/infrastructure/embedders/index.ts"
    },
    "./embedders/stub": {
      "types": "./packages/core/src/infrastructure/embedders/stub.ts",
      "default": "./packages/core/src/infrastructure/embedders/stub.ts"
    },
    "./embedders/openai": {
      "types": "./packages/core/src/infrastructure/embedders/openai.ts",
      "default": "./packages/core/src/infrastructure/embedders/openai.ts"
    },
    "./embedders/local": {
      "types": "./packages/core/src/infrastructure/embedders/local.ts",
      "default": "./packages/core/src/infrastructure/embedders/local.ts"
    },
    "./llms": {
      "types": "./packages/core/src/infrastructure/llms/index.ts",
      "default": "./packages/core/src/infrastructure/llms/index.ts"
    },
    "./llms/stub": {
      "types": "./packages/core/src/infrastructure/llms/stub.ts",
      "default": "./packages/core/src/infrastructure/llms/stub.ts"
    },
    "./llms/openai": {
      "types": "./packages/core/src/infrastructure/llms/openai.ts",
      "default": "./packages/core/src/infrastructure/llms/openai.ts"
    },
    "./cache-pg": {
      "types": "./packages/core/src/infrastructure/db/recall-cache/index.ts",
      "default": "./packages/core/src/infrastructure/db/recall-cache/index.ts"
    }
  },
  "bin": {
    "themory": "./dist/agent-tools/cli.js",
    "themory-mcp": "./dist/agent-tools/cli.js"
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "src/local/migrations/**",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.sql",
    "dist/local/migrations/meta/**"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.contract.json",
    "prebuild:clean": "node -e \"const{rmSync}=require('node:fs');rmSync('dist',{recursive:true,force:true});\"",
    "build": "npm run prebuild:clean && tsc -p tsconfig.build.json && npm run postbuild:copy-migrations",
    "prepack": "npm run build",
    "postbuild:copy-migrations": "node -e \"const{cpSync,existsSync,mkdirSync}=require('node:fs');if(existsSync('packages/core/src/infrastructure/db/migrations')){mkdirSync('dist/infrastructure/db/migrations',{recursive:true});cpSync('packages/core/src/infrastructure/db/migrations','dist/infrastructure/db/migrations',{recursive:true});console.log('migrations copied to dist/infrastructure/db/migrations');}\"",
    "test:type": "tsc --noEmit -p tsconfig.contract.json --strict",
    "lint": "eslint 'packages/core/src/**/*.ts' 'packages/api/src/**/*.ts' 'src/agent-tools/**/*.ts' --no-error-on-unmatched-pattern",
    "test": "vitest run --config vitest.contract.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:benchmark": "vitest run --config vitest.benchmark.config.ts",
    "db:push": "node -e \"const{Pool}=require('pg');const p=new Pool({connectionString:process.env.THEOMEM_PG_URI});p.query('CREATE EXTENSION IF NOT EXISTS vector').then(()=>p.end())\" && drizzle-kit push && node scripts/apply-trigger-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:repair-v0-4b-partial-state": "node scripts/db-repair-v0-4b-partial-state.mjs",
    "db:repair-v0-7-partial-state": "node scripts/db-repair-v0-7-partial-state.mjs",
    "download-fixtures": "node benchmarks/scripts/download-fixtures.mjs",
    "compose:up": "docker compose up -d pgvector",
    "compose:down": "docker compose down",
    "publish:check": "npm publish --dry-run --tag next",
    "eval:forgetting": "tsx docs/forgetting-evaluation/run.ts",
    "eval:distillation": "tsx docs/distillation-evaluation/run.ts"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-openapi": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "commander": "^12.1.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.0",
    "hono": ">=4.11.4",
    "jose": "^6.0.0",
    "oauth4webapi": "^3.8.6",
    "pg": "^8.13.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0",
    "@usetheo/memory-api": "workspace:*"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.30.0",
    "jiti": "^2.7.0",
    "strip-ansi": "^7.1.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0",
    "vitest-mock-extended": "^4.0.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2",
    "natural": "^8.1.0",
    "openai": "^4.77.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/usetheodev/theo-memory.git"
  },
  "bugs": {
    "url": "https://github.com/usetheodev/theo-memory/issues"
  },
  "homepage": "https://usetheo.dev",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "protobufjs"
    ]
  }
}
