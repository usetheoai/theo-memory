engine-strict=true
save-exact=false
auto-install-peers=true
# Hoisted layout (matches the Dockerfile) so the flattened dist/ resolves workspace
# runtime deps (e.g. eld from packages/core) when run standalone via `node dist/...`
# or `npx themory server` on the host — pnpm's default isolated layout leaves them
# under packages/core/node_modules where the flattened dist cannot reach them.
node-linker=hoisted
