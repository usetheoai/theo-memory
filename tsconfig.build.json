{
  "extends": "./tsconfig.contract.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["packages/core/src/**/*.ts", "src/agent-tools/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".claude",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test-d.ts"
  ]
}
