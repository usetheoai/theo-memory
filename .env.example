# TheMemory local-dev env vars. Copy to .env.local and customize.
# NOT consumed by the library itself — only by docker-compose + drizzle-kit + integration tests.

# === Postgres + pgvector (T0.3 docker-compose.yaml) ===
POSTGRES_USER=themem
POSTGRES_PASSWORD=themem
POSTGRES_DB=themem
# Port override if 5432 is taken on your machine (EC-15)
POSTGRES_PORT=5432

# === Connection URI consumed by drizzle-kit (T0.4) + integration tests (T8.1) ===
# Must match POSTGRES_* values above. Update host:port if you set POSTGRES_PORT to anything other than 5432.
THEOMEM_PG_URI=postgresql://themem:themem@localhost:5432/themem
