# TheMemory server environment configuration
# Copy to .env and fill in values; DO NOT commit .env to git.

# SECURITY: Authentication (CRITICAL — RED TEAM F1 fix)
# When set, all REST verb endpoints require Bearer auth.
# When UNSET, the server runs in ALPHA MODE (zero auth).
# Generate a secret: openssl rand -base64 32
THEMEMORY_API_KEY=changeme-generate-a-secret

# Database
THEOMEM_PG_URI=postgresql://themem:themem@localhost:5432/themem

# LLM Provider
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional hosted OpenAI-compatible embeddings (AML Open-source Methods requires
# Alibaba Model Studio text-embedding-v4; default vector dimension is 1024).
# Keep the chat LLM on OPENAI_API_KEY / OPENAI_BASE_URL; this is a separate key.
# THEOMEM_EMBEDDER=compatible
# THEOMEM_EMBEDDING_MODEL=text-embedding-v4
# THEOMEM_EMBEDDING_DIM=1024
# THEOMEM_EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# THEOMEM_EMBEDDING_API_KEY=your-model-studio-api-key
# ALIBABA_API_KEY or DASHSCOPE_API_KEY are also accepted as credential aliases.

# CORS (default * for dev; set for prod)
# THEMORY_CORS_ORIGIN=https://your-app.example.com

# Rate Limiting (defaults: 30 writes/min, 100 reads/min)
# THEMORY_RATE_LIMIT_WRITES=30
# THEMORY_RATE_LIMIT_READS=100
