{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@usetheo/memory": ["./packages/core/src/index.ts"],
      "@usetheo/memory/contract": ["./packages/core/src/domain/index.ts"],
      "@usetheo/memory/embedders/*": ["./packages/core/src/infrastructure/embedders/*"],
      "@usetheo/memory/llms/*": ["./packages/core/src/infrastructure/llms/*"],
      "@usetheo/memory-api": ["./packages/api/src/server/index.ts"]
    }
  },
  "include": ["packages/core/src/**/*.ts", "packages/api/src/**/*.ts", "src/agent-tools/**/*.ts", "benchmarks/scripts/**/*.ts"],
  "exclude": ["node_modules", "referencia", "dist", ".claude"]
}
