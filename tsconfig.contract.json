{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@usetheo/memory": ["./packages/core/src/index.ts"],
      "@usetheo/memory/config": ["./packages/core/src/config-entry.ts"],
      "@usetheo/memory/contract": ["./packages/core/src/domain/index.ts"],
      "@usetheo/memory/recall-trace-pg": ["./packages/core/src/infrastructure/db/recall-trace/index.ts"],
      "@usetheo/memory/embedders/*": ["./packages/core/src/infrastructure/embedders/*"],
      "@usetheo/memory/embedders/openai-compatible": ["./packages/core/src/infrastructure/embedders/openai-compatible.ts"],
      "@usetheo/memory/llms/*": ["./packages/core/src/infrastructure/llms/*"],
      "@usetheo/memory-api": ["./packages/api/src/server/index.ts"],
      "@usetheo/memory-mcp": ["./packages/mcp/src/index.ts"],
      "@usetheo/memory-cli": ["./packages/cli/src/index.ts"],
      "@usetheo/memory-agent-core": ["./packages/agent-core/src/index.ts"]
    }
  },
  "include": ["packages/core/src/**/*.ts", "packages/api/src/**/*.ts", "packages/mcp/src/**/*.ts", "packages/cli/src/**/*.ts", "packages/agent-core/src/**/*.ts", "benchmarks/scripts/**/*.ts"],
  "exclude": ["node_modules", "referencia", "dist", ".claude"]
}
