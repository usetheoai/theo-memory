{
  "name": "@usetheo/memory",
  "version": "0.4.0",
  "description": "The open-source memory layer for AI agents — persistent, multi-tenant memory (facts, conversations & executable skills) on your own Postgres. TypeScript SDK, REST & MCP. Pre-release.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://usetheo.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/usetheoai/theo-memory.git"
  },
  "bugs": {
    "url": "https://github.com/usetheoai/theo-memory/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-memory",
    "long-term-memory",
    "llm",
    "memory",
    "typescript",
    "postgres",
    "pgvector",
    "mcp",
    "model-context-protocol",
    "rag",
    "vector-search",
    "embeddings",
    "semantic-search",
    "openai",
    "self-hosted",
    "multi-tenant"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/**/*.sql",
    "dist/infrastructure/db/migrations/meta/**",
    "src/**/*.ts",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "src/infrastructure/db/migrations/**"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const{cpSync,existsSync}=require('node:fs');const s='src/infrastructure/db/migrations',d='dist/infrastructure/db/migrations';if(existsSync(s)){cpSync(s,d,{recursive:true});console.error('[core] migrations copied to '+d);}\"",
    "prepack": "npm run build",
    "publish:check": "npm pack --dry-run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config-entry.d.ts",
      "default": "./dist/config-entry.js"
    },
    "./contract": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./theokit": {
      "types": "./dist/infrastructure/theokit/index.d.ts",
      "default": "./dist/infrastructure/theokit/index.js"
    },
    "./embedders": {
      "types": "./dist/infrastructure/embedders/index.d.ts",
      "default": "./dist/infrastructure/embedders/index.js"
    },
    "./embedders/stub": {
      "types": "./dist/infrastructure/embedders/stub.d.ts",
      "default": "./dist/infrastructure/embedders/stub.js"
    },
    "./embedders/openai": {
      "types": "./dist/infrastructure/embedders/openai.d.ts",
      "default": "./dist/infrastructure/embedders/openai.js"
    },
    "./embedders/openai-compatible": {
      "types": "./dist/infrastructure/embedders/openai-compatible.d.ts",
      "default": "./dist/infrastructure/embedders/openai-compatible.js"
    },
    "./embedders/local": {
      "types": "./dist/infrastructure/embedders/local.d.ts",
      "default": "./dist/infrastructure/embedders/local.js"
    },
    "./embedders/ollama": {
      "types": "./dist/infrastructure/embedders/ollama.d.ts",
      "default": "./dist/infrastructure/embedders/ollama.js"
    },
    "./embedders/voyage": {
      "types": "./dist/infrastructure/embedders/voyage.d.ts",
      "default": "./dist/infrastructure/embedders/voyage.js"
    },
    "./embedders/google": {
      "types": "./dist/infrastructure/embedders/google.d.ts",
      "default": "./dist/infrastructure/embedders/google.js"
    },
    "./embedders/registry": {
      "types": "./dist/infrastructure/embedders/registry.d.ts",
      "default": "./dist/infrastructure/embedders/registry.js"
    },
    "./llms": {
      "types": "./dist/infrastructure/llms/index.d.ts",
      "default": "./dist/infrastructure/llms/index.js"
    },
    "./llms/stub": {
      "types": "./dist/infrastructure/llms/stub.d.ts",
      "default": "./dist/infrastructure/llms/stub.js"
    },
    "./llms/openai": {
      "types": "./dist/infrastructure/llms/openai.d.ts",
      "default": "./dist/infrastructure/llms/openai.js"
    },
    "./cache-pg": {
      "types": "./dist/infrastructure/db/recall-cache/index.d.ts",
      "default": "./dist/infrastructure/db/recall-cache/index.js"
    },
    "./recall-trace-pg": {
      "types": "./dist/infrastructure/db/recall-trace/index.d.ts",
      "default": "./dist/infrastructure/db/recall-trace/index.js"
    },
    "./reranker-local": {
      "types": "./dist/infrastructure/rerankers/index.d.ts",
      "default": "./dist/infrastructure/rerankers/index.js"
    },
    "./adaptive-local": {
      "types": "./dist/infrastructure/adaptive/index.d.ts",
      "default": "./dist/infrastructure/adaptive/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@opentelemetry/api": "^1.9.0",
    "drizzle-orm": "^0.45.0",
    "eld": "^1.0.1",
    "pg": "^8.13.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2",
    "compromise": "^14.15.1",
    "isolated-vm": "^6.1.2",
    "natural": "^8.2.6",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.0",
    "vitest-mock-extended": "^4.0.0"
  }
}
