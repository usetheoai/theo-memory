# theo-memory.env — config for the Claude Code theo-memory kit.
#
# install.sh copies this to ~/.claude/theo-memory.env (chmod 600) if none exists.
# The endpoint URL is the single config knob — swap it for your target:
#   - local dev:        http://127.0.0.1:8080
#   - deployed REST:    http://<DEV_HOST>:8080
#   - prod gateway:     https://<edge-host>/v1/memory   (owner-resolved; strips /v1/memory prefix)
THEOMEM_MEMORY_URL=http://127.0.0.1:8080

# Bearer token minted from the dashboard (theo_live_...). Required for the deployed /
# gateway endpoints; may be omitted for an unauthenticated local dev server.
# Uncomment and paste your key. Keep this file chmod 600 — it holds a secret.
# THEOMEM_MEMORY_TOKEN=theo_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
