# theo-memory.env — config for the Claude Code theo-memory kit.
#
# install.sh copies this to ~/.claude/theo-memory.env (chmod 600) if none exists.
#
# Two knobs: the host, and the path prefix the capability is namespaced under.
#   - local dev:   URL=http://127.0.0.1:8080          PREFIX unset  → /v1/recall
#   - dev gateway: URL=https://app-dev.usetheo.dev    PREFIX=/v1/memory → /v1/memory/recall
#
# The prefix is separate on purpose. Folding it into the URL (as an earlier version of
# this file suggested) produced /v1/memory/v1/recall, because the hooks append the verb
# path themselves. Going through the gateway is preferred: it authenticates, strips the
# client key, and injects a per-tenant credential downstream, so the service never sees
# your key (CWE-441).
THEOMEM_MEMORY_URL=http://127.0.0.1:8080
# THEOMEM_MEMORY_PATH_PREFIX=/v1/memory

# Bearer token minted from the dashboard (theo_live_...). Required for the deployed /
# gateway endpoints; may be omitted for an unauthenticated local dev server.
# Uncomment and paste your key. Keep this file chmod 600 — it holds a secret.
# THEOMEM_MEMORY_TOKEN=theo_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
