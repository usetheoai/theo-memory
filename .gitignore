# Node.js
node_modules/
dist/
*.tsbuildinfo
.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Project-local MCP server registration (Claude Code reads this for mcpServers;
# contains OPENAI_API_KEY for the themory MCP server). .mcp.json.example IS
# committed as the docs template; the real file is local-only per .mcp.json.example § _README.
.mcp.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code working directory — per-developer session state, never committed.
# Not to be confused with .claude-plugin/ (the published plugin manifest) or
# docs/claude-code-kit/ (the shipped hooks kit), both of which ARE tracked.
.claude/
CLAUDE.local.md

# Python tooling caches
**/__pycache__/
*.pyc
*.pyo
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/.hypothesis/
**/.benchmarks/
.coverage
htmlcov/
*.egg-info/

# Per-session skill/agent working dirs
**/.theo/
.dev-mcp-client/
halt-loop-prompts/

# Benchmark fixtures + results — datasets are fetched, never vendored
# (LongMemEval_oracle: license + size). See E2E_QA_DATASET.
benchmarks/data/
benchmarks/results/

# JS coverage output
coverage/

# theo-memory Claude Code plugin manifest (tracked despite the global .mcp.json ignore)
!docs/claude-code-kit/.mcp.json
